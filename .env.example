# ============================================
# 환경 변수 설정 파일 (.env)
# ============================================
# 이 파일을 .env로 복사한 후, 각 항목에 실제 값을 입력하세요.
#   cp .env.example .env
# ============================================

# Telegram Bot 설정
# @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 봇이 메시지를 발송할 그룹 채팅방 ID (음수 형태, 예: -1001234567890)
GROUP_CHAT_ID=your_group_chat_id_here

# Google Sheets 설정
# 연동할 Google 스프레드시트 이름
GOOGLE_SHEET_NAME=your_google_sheet_name_here

# Google Cloud 서비스 계정 인증 키 파일 경로
GOOGLE_CREDENTIALS_FILE=credentials.json
