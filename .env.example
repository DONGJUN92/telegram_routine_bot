# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GROUP_CHAT_ID=your_group_chat_id_here
OWNER_USER_ID=1415330667

# Google Sheets Settings
GOOGLE_SHEET_NAME=your_google_sheet_name_here
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_WRITE_LIMIT_PER_MINUTE=30
GOOGLE_SHEETS_MAX_RETRIES=5
GOOGLE_SHEETS_QUOTA_COOLDOWN_SECONDS=65

# OpenRouter AI Settings (:free models dynamic fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local / Render Runtime Safety
BOT_LOG_DIR=logs
BOT_LOG_LEVEL=INFO
BOT_INSTANCE_LOCK_PORT=47219
PORT=10000

# Main-Bot Personal DM Delivery (Optional)
PERSONAL_NOTIFICATION_SEND_INTERVAL_SECONDS=0.05
